# Copy to `.env` and fill in. NEVER commit the real .env (it is gitignored).

# --- LLM providers (chain: NVIDIA NIM is tried first, then OpenRouter) ---
# NVIDIA NIM (https://build.nvidia.com) — optional; leave NIM_API_KEY empty to skip.
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODELS=mistralai/mistral-medium-3.5-128b,deepseek-ai/deepseek-v4-flash

# OpenRouter (https://openrouter.ai) — OpenAI-compatible chat completions.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated, tried in order; skips to next on rate-limit / error.
OPENROUTER_MODELS=openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT_SEC=60

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Public base served by Caddy (no trailing slash)
TELEGRAM_WEBHOOK_BASE=https://your-domain.example.com
# Secret path Caddy forwards to the bot (leading slash, keep it unguessable)
TELEGRAM_WEBHOOK_PATH=/tg/CHANGE_ME_RANDOM
# Verified against the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_RANDOM
# Where the bot's own HTTP server binds (Caddy reverse-proxies to this)
WEBHOOK_LISTEN_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Comma-separated chat ids allowed to use the bot. Empty = allow everyone.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Postgres ---
# POSTGRES_PASSWORD initializes the db container; DATABASE_URL is for host-side
# tools (the bot container gets db:5432 from docker-compose). Keep them in sync.
DATABASE_URL=postgresql://crypto:CHANGE_ME@localhost:5433/crypto
POSTGRES_PASSWORD=CHANGE_ME

# --- Embeddings (NVIDIA NIM API → OpenRouter same-model fallback; app/embeddings.py) ---
# Defaults reuse NIM_API_KEY / OPENROUTER_API_KEY above — nothing extra to set.
# 2048-dim nvidia/nemotron-3-embed-1b; must match the vector(2048) column in schema.sql.
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# EMBED_FALLBACK_MODEL=nvidia/nemotron-3-embed-1b:free

# --- Market data (optional; falls back to CoinGecko free if unset) ---
CMC_API_KEY=

# --- Podcasts (optional) ---
# YouTube blocks caption scraping from datacenter IPs; point this at a
# Netscape cookies.txt exported from a throwaway account, or set PODCAST_PROXY.
PODCAST_YTDLP_COOKIES=/secrets/cookies.txt
PODCAST_INTERVAL_MIN=360

# --- Tunables ---
INGEST_INTERVAL_MIN=20
SEARCH_TOPK=40
SEARCH_WINDOW_DAYS=30
IVFFLAT_PROBES=10
DIGEST_WINDOW_HOURS=24
DIGEST_LIMIT=200
CACHE_TTL_HOURS=24
MEMORY_WINDOW=20
AGENT_MAX_STEPS=8
LOG_LEVEL=INFO

# --- Monitoring dashboard (Caddy basic_auth at /monitor) ---
MONITOR_USER=admin
MONITOR_PASSWORD=CHANGE_ME
MONITOR_PORT=8090

# --- Advanced ---
# Additional optional tunables (podcast channels/limits, analyst window,
# LLM rate limiting, container prefix, etc.) all have sensible defaults in
# app/config.py — set them here only if you need to override.
